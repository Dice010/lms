// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// 1. GENERATOR: Chỉ định công cụ sinh code (luôn là prisma-client-js cho Next.js)
generator client {
  provider = "prisma-client-js"
}

// 2. DATASOURCE: Khai báo loại Database
datasource db {
  provider = "sqlite" // Chúng ta chọn dùng SQLite siêu nhẹ ở đây
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // Vì làm Auth cứng tạm thời nên ta lưu pass đơn giản
  fullName  String
  // Cột Role quản lý quyền hạn (Lưu dưới dạng chuỗi: "ADMIN", "HIEU_TRUONG", "HR", "PHONG_DAO_TAO", "TRUONG_BO_MON", "GIANG_VIEN", "SINH_VIEN")
  role      String   @default("SINH_VIEN") 
  status    String   @default("Hoạt động")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // Prisma tự cập nhật thời gian mỗi khi bạn sửa thông tin user
}

// --- Bổ sung vào cuối tệp prisma/schema.prisma ---

model Course {
  id          Int      @id @default(autoincrement())
  title       String   // Tiêu đề bài học / khóa học (Trí đặt là title)
  subject     String   // Tên môn học (VD: Lập trình Java, CTDL & GT)
  status      String   @default("Bản nháp") // "Bản nháp" hoặc "Đã công bố"
  uploadedAt  String   // Lưu ngày tạo dạng chuỗi YYYY-MM-DD như mock data của Trí
  assignedTeacher String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Exam {
  id          Int      @id @default(autoincrement())
  title       String   // Tiêu đề bài kiểm tra
  subject     String   // Môn học thuộc bài kiểm tra
  duration    Int      // Thời gian làm bài (phút)
  questions   Int      // Số lượng câu hỏi
  openAt      String   // Thời gian mở đề dạng chuỗi
  status      String   @default("Bản nháp") // "Bản nháp" hoặc "Đã công bố"
  createdAt   DateTime @default(now())
}

model ExamResult {
  id          Int      @id @default(autoincrement())
  examTitle   String   // Tên bài thi tương ứng
  student     String   // Tên sinh viên làm bài
  score       Float    // Điểm số hệ 10
  submittedAt String   // Thời gian nộp bài
}